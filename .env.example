AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=YOUR-KEY
# Actual Azure deployment names, not necessarily model names. Edit in the app too.
JUDGE_DEPLOYMENTS=gpt-realtime-2.1,gpt-realtime-2.1-mini
PORT=4310
